# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

platform :ios do
  before_all do
    # Set Flutter root path
    ENV["FLUTTER_ROOT"] = "/opt/homebrew/bin/flutter" # Adjust path if needed
    
    # Ensure we're in the Flutter project directory
    unless File.exist?("../pubspec.yaml")
      UI.user_error!("pubspec.yaml not found. Make sure you're in the Flutter project root directory.")
    end
  end

  desc "Build and upload a new release to App Store"
  lane :release do
    # Clean and get dependencies
    sh("cd ../.. && flutter clean")
    sh("cd ../.. && flutter pub get")
    
    # Run Flutter tests (skip if test directory doesn't exist)
    begin
      sh("cd ../.. && flutter test")
    rescue => ex
      UI.message("Skipping tests: #{ex.message}")
    end
    
    # Build Flutter iOS app
    sh("cd ../.. && flutter build ios --release --no-codesign")
    
    # Increment build number
    increment_build_number(
      xcodeproj: "Runner.xcodeproj",
      build_number: get_build_number(xcodeproj: "Runner.xcodeproj").to_i + 1
    )
    
    # Build the app with proper signing
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      export_options: {
        method: "app-store",
        teamID: "6XT4R7V83F",
        uploadBitcode: false,
        uploadSymbols: true,
        stripSwiftSymbols: true
      },
      output_directory: "./build",
      output_name: "TaxLien.ipa"
    )
    
    # Upload to App Store
    upload_to_app_store(
      force: true,
      skip_binary_upload: false,
      skip_screenshots: false,
      skip_metadata: false,
      submit_for_review: false,
      automatic_release: false
    )
    
    # Clean up
    clean_build_artifacts
  end

  desc "Build and upload a new beta release to TestFlight"
  lane :beta do
    # Clean and get dependencies
    sh("cd ../.. && flutter clean")
    sh("cd ../.. && flutter pub get")
    
    # Run Flutter tests (skip if test directory doesn't exist)
    begin
      sh("cd ../.. && flutter test")
    rescue => ex
      UI.message("Skipping tests: #{ex.message}")
    end
    
    # Build Flutter iOS app
    sh("cd ../.. && flutter build ios --release --no-codesign")
    
    # Increment build number
    increment_build_number(
      xcodeproj: "Runner.xcodeproj",
      build_number: get_build_number(xcodeproj: "Runner.xcodeproj").to_i + 1
    )
    
    # Build the app for TestFlight
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      export_options: {
        method: "app-store",
        teamID: "6XT4R7V83F",
        uploadBitcode: false,
        uploadSymbols: true,
        stripSwiftSymbols: true
      },
      output_directory: "./build",
      output_name: "TaxLien-Beta.ipa"
    )
    
    # Upload to TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build app for local testing"
  lane :build do
    # Clean and get dependencies
    sh("cd ../.. && flutter clean")
    sh("cd ../.. && flutter pub get")
    
    # Build Flutter iOS app
    sh("cd ../.. && flutter build ios --release --no-codesign")
    
    # Build the app
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "development",
      output_directory: "./build",
      output_name: "TaxLien-Development.ipa"
    )
  end

  desc "Update app metadata"
  lane :metadata do
    # Update app metadata from fastlane/metadata
    deliver(
      force: true,
      skip_binary_upload: true,
      skip_screenshots: false,
      skip_metadata: false
    )
  end

  desc "Download existing metadata and screenshots from App Store"
  lane :download_metadata do
    download_metadata
    download_screenshots
  end

  desc "Submit app for review"
  lane :submit do
    upload_to_app_store(
      force: true,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      submit_for_review: true,
      automatic_release: false
    )
  end

  desc "Release app automatically after approval"
  lane :release_auto do
    upload_to_app_store(
      force: true,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      submit_for_review: false,
      automatic_release: true
    )
  end

  error do |lane, exception|
    # Handle errors
    UI.error("Error in lane #{lane}: #{exception.message}")
    clean_build_artifacts
  end
end
